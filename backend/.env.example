##############################################################
# Local-development defaults (NOT for production).
# Copy to backend/.env or let `python setup.py` do it.
# Deploy: edit this file — see docs/deploy-guide.md
##############################################################

##############################################################
# Information Environment Variables
##############################################################
PROJECT_NAME="FastAPI Async SQLModel Boilerplate"
PROJECT_DESCRIPTION="A fully asynchronous FastAPI boilerplate. Built for extensibility and speed, it incorporates FastAPI, SQLModel, Alembic, PostgreSQL, Redis, Celery and Locust. 🚀"
APP_VERSION="0.0.1"
CONTACT_NAME="Example Name"
CONTACT_EMAIL="example@example.com.br"
LICENSE_NAME="MIT"

##############################################################
# Web Server Environment Variables
##############################################################
API_BASE_URL="http://127.0.0.1:8000"
WEB_CONCURRENCY=1

##############################################################
# Security Environment Variables
# SECRET_KEY is generated by the CLI if left empty.
##############################################################
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

##############################################################
# Email Environment Variables
##############################################################
SMTP_HOST="smtp.azurecomm.net"
SMTP_PORT=587
SMTP_USER="SMTP_USER"
SMTP_PASSWORD="SMTP_PASSWORD"
EMAILS_FROM_EMAIL="email@example.com"
EMAILS_FROM_NAME="Example Name"
EMAIL_SENDER="logger"

##############################################################
# Database Environment Variables
##############################################################
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_SERVER="127.0.0.1"
POSTGRES_PORT=5432
POSTGRES_DB="postgres"
POSTGRES_POOL_SIZE=100

##############################################################
# Redis for Caching Environment Variables
##############################################################
REDIS_CACHE_HOST="127.0.0.1"
REDIS_CACHE_PORT=6379
REDIS_CACHE_DB=0
REDIS_CACHE_USERNAME="default"
REDIS_CACHE_PASSWORD="password"
REDIS_CACHE_USE_SSL=False

##############################################################
# Redis for Rate Limit Environment Variables (Optional)
# Empty HOST falls back to REDIS_CACHE_* in config.py
# DB is used only when HOST is set; otherwise the cache URL (and DB) is used.
##############################################################
REDIS_RATE_LIMIT_HOST=""
REDIS_RATE_LIMIT_PORT=6379
REDIS_RATE_LIMIT_DB=0
REDIS_RATE_LIMIT_USERNAME=""
REDIS_RATE_LIMIT_PASSWORD=""
REDIS_RATE_LIMIT_USE_SSL=False

##############################################################
# Redis for Celery Broker Environment Variables (Optional)
# Empty HOST falls back to REDIS_CACHE_* in config.py
# DB is used only when HOST is set; otherwise the cache URL (and DB) is used.
##############################################################
REDIS_BROKER_HOST=""
REDIS_BROKER_PORT=6379
REDIS_BROKER_DB=0
REDIS_BROKER_USERNAME=""
REDIS_BROKER_PASSWORD=""
REDIS_BROKER_USE_SSL=False

##############################################################
# First Admin User Creation Environment Variables
##############################################################
USER_FIRST_ADMIN_NAME="Admin User"
USER_FIRST_ADMIN_EMAIL="admin@system.com"
USER_FIRST_ADMIN_USERNAME="admin"
USER_FIRST_ADMIN_PASSWORD="!Ch4ng3Th1sP4ssW0rd!"

##############################################################
# Running Mode Environment Variables
##############################################################
ENVIRONMENT="local"

##############################################################
# Logging Environment Variables
# PaaS / Compose: LOG_FORMAT=json and LOG_TO_FILE=false (stdout only).
##############################################################
LOG_FORMAT=text
LOG_TO_FILE=True
LOG_LEVEL=DEBUG

##############################################################
# CORS Environment Variables
# Native Android/iOS clients ignore CORS. See docs/deploy-guide.md.
##############################################################
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=False
CORS_EXPOSE_HEADERS=
CORS_MAX_AGE=600

##############################################################
# Rate Limit Environment Variables
##############################################################
DEFAULT_RATE_LIMIT_LIMIT=4
DEFAULT_RATE_LIMIT_PERIOD=1

##############################################################
# Celery Flower Environment Variables
# Format: user:password (e.g. admin:s3cr3t)
##############################################################
FLOWER_BASIC_AUTH="admin:changeme"
